---
layout: null
permalink: /reading.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ site.reading.title | xml_escape }}</title>
    <link>{{ site.url }}/</link>
    <description>{{ site.reading.description | xml_escape }}</description>
    <language>en</language>
    <atom:link href="{{ site.url }}/reading.xml" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ site.data.sitemap_meta.home_updated_at | date_to_rfc822 }}</lastBuildDate>
    {% for article in site.data.reading limit: site.reading.feed_limit %}
    <item>
      <title>{{ article.title | xml_escape }}</title>
      <link>{{ article.url | xml_escape }}</link>
      <guid isPermaLink="false">natalenko-reading-{{ article.id | xml_escape }}</guid>
      {% if article.liked_at %}<pubDate>{{ article.liked_at | date_to_rfc822 }}</pubDate>{% endif %}
      <description>{% if article.description %}{% assign rendered_description = article.description | strip %}{% assign description_last_character = rendered_description | slice: -1, 1 %}{{ rendered_description | xml_escape }}{% unless description_last_character == "." %}...{% endunless %}{% elsif article.source %}From {{ article.source | xml_escape }}{% else %}Recommended reading{% endif %}</description>
      {% if article.image %}<media:thumbnail url="{{ article.image | xml_escape }}" />{% endif %}
    </item>
    {% endfor %}
  </channel>
</rss>
